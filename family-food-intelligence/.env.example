# =============================================================================
# Family Food Intelligence — environment template
#
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Every value marked REQUIRED has no default: the application refuses to start
# without it, which is deliberate. A guessable signing key is worse than a crash.
# =============================================================================

# ---- Database ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/familyfood
DB_USERNAME=familyfood
DB_PASSWORD=                       # REQUIRED outside local
DB_POOL_MAX=10

# ---- Authentication ---------------------------------------------------------
# REQUIRED. Base64 of at least 32 random bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=family-food-intelligence

# ---- Privacy ----------------------------------------------------------------
# REQUIRED. Peppers the one-way hashes used for emails in the throttling table,
# IP addresses and search text (D-018). Changing it invalidates existing
# pseudonyms — it is not a rotating value; treat it as long-lived.
#   openssl rand -base64 32
PRIVACY_HASH_PEPPER=

# ---- Object storage (label images) -----------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=ap-south-1
STORAGE_BUCKET=familyfood-labels
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=true            # true for MinIO, false for real S3

# ---- Caching (D-056) ---------------------------------------------------------
# caffeine (default): in-process, correct for one instance, nothing below needed.
# redis: shared cache — opt-in, off by default. `scripts\start-dev.ps1 -WithRedis`
#   sets this and starts the Redis container together; manually, start it with
#   `docker compose --profile redis up -d` (a plain `docker compose up` does not
#   start it). Optional at runtime: a missing or unreachable Redis falls back to
#   the database.
# none: caching off entirely.
CACHE_TYPE=caffeine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                    # required only outside local (AUTH), see docs/operations
REDIS_SSL=false

# ---- AI provider ------------------------------------------------------------
# AI_ENABLED=false is a fully supported production state (D-011). With it off:
#   - label OCR degrades to manual entry
#   - explanations are served from deterministic templates
# The product remains completely usable. Do not treat this as a broken config.
AI_ENABLED=false
AI_PROVIDER=
AI_API_KEY=
AI_OCR_MODEL=
AI_EXPLANATION_MODEL=

# ---- Web --------------------------------------------------------------------
SERVER_PORT=8090
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Profile ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
