<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!--
    Every message passes through MaskingMessageConverter before it reaches an appender.
    This is the enforcement point for "no health data in logs" (AC-9.4, Constitution §43):
    it cannot be forgotten at a call site because it lives in the appender path.
  -->
  <conversionRule conversionWord="maskedMsg"
                  class="com.familyfood.platform.logging.MaskingMessageConverter"/>

  <springProfile name="local,test">
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
      <encoder>
        <pattern>%d{HH:mm:ss.SSS} %-5level [%X{correlationId:-}] %logger{36} - %maskedMsg%n</pattern>
      </encoder>
    </appender>
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <springProfile name="prod">
    <!-- Structured JSON to stdout; the platform ships it onward. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
      <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
        <providers>
          <timestamp><fieldName>timestamp</fieldName></timestamp>
          <logLevel><fieldName>level</fieldName></logLevel>
          <loggerName><fieldName>logger</fieldName><shortenedLoggerNameLength>40</shortenedLoggerNameLength></loggerName>
          <threadName><fieldName>thread</fieldName></threadName>
          <!--
            The message is rendered through the masking converter. Note that we do NOT
            use <message/> here, which would emit the raw text and bypass masking.
          -->
          <pattern>
            <pattern>{"message":"%maskedMsg"}</pattern>
          </pattern>
          <mdc/>
          <stackTrace>
            <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
              <maxDepthPerThrowable>30</maxDepthPerThrowable>
              <maxLength>4096</maxLength>
              <rootCauseFirst>true</rootCauseFirst>
            </throwableConverter>
          </stackTrace>
        </providers>
      </encoder>
    </appender>
    <root level="WARN">
      <appender-ref ref="JSON"/>
    </root>
    <logger name="com.familyfood" level="INFO"/>
    <logger name="access" level="INFO"/>
  </springProfile>

</configuration>
